# Appwrite connection. Both are public — they are compiled into the JavaScript
# the browser downloads, and neither authorises anything on its own. What guards
# a reader's record is the per-document permission naming that one user.
#
# Copy to .env for local development. On Appwrite Sites, set the same two under
# the site's environment variables so the hosted build gets them too.
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6a7d8102003bcdb355c1

# Only needed to point at a database or collection other than the defaults
# ("qazotrack" and "records") set in client/src/lib/appwrite.ts.
# VITE_APPWRITE_DATABASE_ID=qazotrack
# VITE_APPWRITE_RECORDS_TABLE_ID=records
